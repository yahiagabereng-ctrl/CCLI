  <diagram name="4-CCLI-Config" id="tr400-ccli-config">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t4" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" value="CCLI Configuration &amp; ubus DIO API — lab_tr400.yaml" vertex="1">
          <mxGeometry height="36" width="1200" x="200" y="20" as="geometry" />
        </mxCell>
        <mxCell id="yaml_g" parent="1" style="swimlane;startSize=28;fillColor=#DCFCE7;strokeColor=#166534;fontStyle=1;fontSize=12;" value="apps/ccli/config/lab_tr400.yaml → deploy /etc/ccli/lab.yaml" vertex="1">
          <mxGeometry height="760" width="720" x="60" y="80" as="geometry" />
        </mxCell>
        <mxCell id="yaml_txt" parent="yaml_g" style="text;html=1;strokeColor=#166534;fillColor=#FFFFFF;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;spacing=8;" value="platform: tg500&#xa;&#xa;lab: TG544 · tespro,tr500 · 192.168.1.130/24&#xa;serial: ttyS1/ttyS2/ttyS0 · modbus RTU ttyS1&#xa;pf2: threshold 900 kW · debounce/min timers&#xa;&#xa;io: (all DIO = PF2)&#xa;  backend: ubus_dido_v2&#xa;  do_curtail:     ch1 active_high false&#xa;  di_permissive:  ch2 active_low true&#xa;  di_pf2_spare:   ch3 active_low true&#xa;  do_pf2_spare:   ch4 active_high false&#xa;&#xa;analog: (DRC-60A UPS)&#xa;  ai_battery_v: AI1 · divider 120k/39k&#xa;  ai_ups_status: AI2 · AC OK + bat low&#xa;  ao_load_shed: AO1 → K2 optional&#xa;  analog_gnd: AOG → Bat−&#xa;&#xa;ups: MEAN_WELL_DRC-60A · TB2 +V/−V → TG544 input" vertex="1">
          <mxGeometry height="700" width="680" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="uci_g" parent="1" style="swimlane;startSize=28;fillColor=#EFF6FF;strokeColor=#334155;fontStyle=1;fontSize=12;" value="/etc/config/ccli (UCI mirror — TR400 values)" vertex="1">
          <mxGeometry height="280" width="700" x="820" y="80" as="geometry" />
        </mxCell>
        <mxCell id="uci_txt" parent="uci_g" style="text;html=1;strokeColor=#334155;fillColor=#FFFFFF;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacing=6;" value="config ccli &#39;main&#39;&#xa;  option enabled &#39;1&#39;&#xa;  option config_file &#39;/etc/ccli/lab.yaml&#39;&#xa;&#xa;config pf2 &#39;pf2&#39;&#xa;  option threshold_kw &#39;900&#39;&#xa;  option release_threshold_kw &#39;850&#39;&#xa;  option debounce_s &#39;30&#39;&#xa;  option stale_data_s &#39;10&#39;&#xa;  option min_on_s &#39;60&#39;&#xa;  option min_off_s &#39;30&#39;&#xa;&#xa;config io &#39;plant&#39;&#xa;  option do_curtail_gpio &#39;1&#39;      ← DIO1 ubus ch&#xa;  option do_curtail_active_high &#39;0&#39;&#xa;  option di_permissive_gpio &#39;2&#39;   ← DIO2 ubus ch&#xa;  option di_permissive_active_low &#39;1&#39;&#xa;  option gpio_lab_blink &#39;0&#39;       ← MUST stay 0 field" vertex="1">
          <mxGeometry height="220" width="660" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="ubus_g" parent="1" style="swimlane;startSize=28;fillColor=#FEF2F2;strokeColor=#334155;fontStyle=1;fontSize=12;" value="ubus dido_v2 API (GD32 — CONFIRMED bench)" vertex="1">
          <mxGeometry height="440" width="700" x="820" y="400" as="geometry" />
        </mxCell>
        <mxCell id="ubus_prep" parent="ubus_g" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#B45309;fontSize=10;align=left;fontFamily=Courier New;" value="Prep (once):&#xa;uci set didoservice_v2.channel_2.mode=di&#xa;uci commit didoservice_v2&#xa;/etc/init.d/didoservice_v2 restart" vertex="1">
          <mxGeometry height="70" width="660" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="ubus_cmds" parent="ubus_g" style="text;html=1;strokeColor=#334155;fillColor=#FFFFFF;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacing=6;" value="DO curtail (DIO1 / ch1):&#xa;  ubus call dido_v2 set_relay &#39;{&quot;channel&quot;:1,&quot;value&quot;:1}&#39;&#xa;  ubus call dido_v2 set_relay &#39;{&quot;channel&quot;:1,&quot;value&quot;:0}&#39;  ← safe&#xa;&#xa;DI permissive (DIO2 / ch2):&#xa;  ubus call dido_v2 read_di &#39;{&quot;channel&quot;:2}&#39;&#xa;&#xa;Status:&#xa;  ubus call dido_v2 status" vertex="1">

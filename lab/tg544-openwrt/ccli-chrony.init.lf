#!/bin/sh /etc/rc.common
# CCLI lab: chronyd + GNSS SOCK feeder (replace BusyBox ntpd).
START=65
STOP=15
USE_PROCD=1

CHRONY_BIN=/usr/sbin/chronyd
CHRONY_CONF=/etc/chrony/chrony.conf
FEEDER_BIN=/usr/sbin/gnss_chrony_sock
SOCK=/var/run/chrony.gnss.sock

start_service() {
	/etc/init.d/sysntpd stop 2>/dev/null
	killall -q ntpd 2>/dev/null

	mkdir -p /var/lib/chrony /var/run/chrony /var/log/chrony /etc/chrony
	rm -f "$SOCK"

	procd_open_instance chronyd
	procd_set_param command "$CHRONY_BIN" -f "$CHRONY_CONF"
	procd_set_param respawn
	procd_close_instance

	if [ -x "$FEEDER_BIN" ]; then
		procd_open_instance gnss_sock
		procd_set_param command /bin/sh -c "sleep 2; exec $FEEDER_BIN $SOCK 16"
		procd_set_param respawn
		procd_close_instance
	fi
}

stop_service() {
	killall -q gnss_chrony_sock 2>/dev/null
	killall -q chronyd 2>/dev/null
}

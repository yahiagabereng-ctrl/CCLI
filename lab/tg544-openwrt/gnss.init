#!/bin/sh /etc/rc.common
# GNSS Positioning Service
# Copyright (C) 2024-2026 Tespro Technology Co., Ltd.
#
# This service starts GNSS positioning on boot if enabled in UCI config

START=99
STOP=10
USE_PROCD=1

start_service() {
    # Check if GNSS is enabled in UCI config
    local enabled
    enabled=$(uci -q get gnss.general.enabled)

    if [ "$enabled" != "1" ]; then
        logger -t gnss "GNSS positioning is disabled in config"
        return 0
    fi

    # Start a supervised worker immediately. Modem waits and AT requests must
    # not run synchronously in the boot sequence or hold up later S99 services.
    procd_open_instance startup
    procd_set_param command /usr/sbin/gnss-start-worker
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # Stop the monitor first so it cannot turn GNSS back on during shutdown.
    procd_kill gnss startup
    local result
    result=$(ubus -t 10 call sim-manager gnss_stop 2>/dev/null) || return 1
    if [ "$(jsonfilter -s "$result" -e '@.success' 2>/dev/null)" = true ]; then
        logger -t gnss "GNSS stop request accepted"
    else
        logger -t gnss "GNSS stop request failed"
        return 1
    fi
}

reload_service() {
    local enabled
    enabled=$(uci -q get gnss.general.enabled)

    if [ "$enabled" = "1" ]; then
        start
    else
        stop
    fi
}

service_triggers() {
    procd_add_reload_trigger "gnss"
}

config updater 'main'
	option enabled '1'
	option interval '15'
	option max_depth '8'
	option require_tpm '1'
	option tpm_nv_index '0x1500016'
	option tpm_operator_ca_index '0x1500017'
	option tpm_operator_crl_index '0x1500018'
	option tpm_manufacturer_key_index '0x1500019'

	# Provision a unique value on every TesPro before enabling production updates.
	option device_id ''

	# EJBCA operator trust is read from TPM NV during every verification.
	option operator_role 'firmware-update'
	option operator_role_subject 'OU=Firmware Update Operators'
	option max_authorization_seconds '86400'

	# The release public key is read from TPM NV into a temporary key directory.

	# Annex T update controls: persistent audit and controlled CCLI stop/start.
	option audit_log '/mnt/mmcblk0/firmware-updater/security-audit.log'
	option require_persistent_audit '1'
	option ccli_service 'ccli'
	option require_ccli_deactivation '1'

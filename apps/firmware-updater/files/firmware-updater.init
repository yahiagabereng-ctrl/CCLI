#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

start_service() {
	enabled="$(uci -q get firmware-updater.main.enabled 2>/dev/null)"
	[ "${enabled:-1}" = "1" ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/firmware-updater --daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

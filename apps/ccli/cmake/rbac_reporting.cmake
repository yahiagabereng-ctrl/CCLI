# Add an authorization check before queued/buffered report delivery without
# editing the libIEC61850 checkout or any TLS/ACSE/session/presentation source.
# A generated copy is used so this change is reproducible in SDK builds.
set(_rbac_reporting "${CCLI_LIBIEC61850_DIR}/src/iec61850/server/mms_mapping/reporting.c")
file(READ "${_rbac_reporting}" _rbac_reporting_text)
set(_rbac_send_anchor "if (rc->enabled) {\n                sendNextReportEntry(rc);")
string(FIND "${_rbac_reporting_text}" "${_rbac_send_anchor}" _rbac_send_position)
if(_rbac_send_position LESS 0)
    message(FATAL_ERROR "RBAC reporting guard requires review for this libIEC61850 revision")
endif()
set(_rbac_send_guard "if (rc->enabled) {\n                /* CCLI: preserve legacy behavior when no access handler is installed. */\n                if (!self->controlBlockAccessHandler ||\n                    rc->reportBuffer->nextToTransmit == NULL ||\n                    ReportControl_readAccess(rc, self, connection, \"__RBAC_REPORT_SEND__\"))\n                    sendNextReportEntry(rc);")
string(REPLACE "${_rbac_send_anchor}" "${_rbac_send_guard}" _rbac_reporting_text "${_rbac_reporting_text}")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/generated/rbac")
set(_rbac_generated_reporting "${CMAKE_BINARY_DIR}/generated/rbac/reporting.c")
file(WRITE "${_rbac_generated_reporting}" "${_rbac_reporting_text}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_rbac_reporting}")
foreach(_rbac_target iec61850 iec61850-shared)
    if(TARGET ${_rbac_target})
        get_target_property(_rbac_sources ${_rbac_target} SOURCES)
        get_target_property(_rbac_source_dir ${_rbac_target} SOURCE_DIR)
        set(_rbac_replacement_sources "")
        foreach(_rbac_source IN LISTS _rbac_sources)
            if(_rbac_source MATCHES "[/\\]reporting\\.c$")
                list(APPEND _rbac_replacement_sources "${_rbac_generated_reporting}")
            elseif(IS_ABSOLUTE "${_rbac_source}" OR _rbac_source MATCHES "^\\$<")
                list(APPEND _rbac_replacement_sources "${_rbac_source}")
            else()
                list(APPEND _rbac_replacement_sources "${_rbac_source_dir}/${_rbac_source}")
            endif()
        endforeach()
        set_property(TARGET ${_rbac_target} PROPERTY SOURCES "${_rbac_replacement_sources}")
        target_include_directories(${_rbac_target} PRIVATE
            "${CCLI_LIBIEC61850_DIR}/src/iec61850/server/mms_mapping")
    endif()
endforeach()

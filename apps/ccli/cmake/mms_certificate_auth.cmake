# Extend ACSE certificate authentication without editing vendor or TLS sources.
find_package(Python3 REQUIRED COMPONENTS Interpreter)
get_filename_component(_ccli_repo "${CMAKE_CURRENT_SOURCE_DIR}/../.." ABSOLUTE)
set(_dual_generator "${_ccli_repo}/scripts/generate_mms_certificate_auth.py")
set(_dual_baseline "${_ccli_repo}/lab/conformance/CCI_RBAC_TLS_BASELINE.json")
if(NOT EXISTS "${_dual_generator}")
    # The OpenWrt source package includes these build inputs beside this module.
    set(_dual_generator "${CMAKE_CURRENT_LIST_DIR}/generate_mms_certificate_auth.py")
    set(_dual_baseline "${CMAKE_CURRENT_LIST_DIR}/CCI_RBAC_TLS_BASELINE.json")
endif()
set(_dual_output "${CMAKE_BINARY_DIR}/generated/dual-certificate")
set(_dual_base_output "${CMAKE_BINARY_DIR}/generated/dual-certificate-base")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${_dual_generator}"
    --vendor "${CCLI_LIBIEC61850_DIR}" --output "${_dual_base_output}" --baseline "${_dual_baseline}"
    RESULT_VARIABLE _dual_result ERROR_VARIABLE _dual_error)
if(NOT _dual_result EQUAL 0)
    message(FATAL_ERROR "Certificate authentication overlay: ${_dual_error}")
endif()
if(CCLI_MMS_TSP_CLIENT_PROFILE)
    set(_tsp_generator "${_ccli_repo}/scripts/generate_mms_tsp_client.py")
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${_tsp_generator}"
        --vendor "${CCLI_LIBIEC61850_DIR}" --output "${_dual_base_output}"
        RESULT_VARIABLE _tsp_result ERROR_VARIABLE _tsp_error)
    if(NOT _tsp_result EQUAL 0)
        message(FATAL_ERROR "TSP client overlay: ${_tsp_error}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_tsp_generator}")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_dual_generator}")
set(_e2e_generator "${_ccli_repo}/scripts/generate_mms_e2e.py")
if(NOT EXISTS "${_e2e_generator}")
    set(_e2e_generator "${CMAKE_CURRENT_LIST_DIR}/generate_mms_e2e.py")
endif()
set(_e2e_header "${CMAKE_CURRENT_SOURCE_DIR}/adapters/iec61850_mms/e2e/e2e_osi_bridge.h")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${_e2e_generator}"
    --input "${_dual_base_output}" --output "${_dual_output}" --header "${_e2e_header}"
    --vendor "${CCLI_LIBIEC61850_DIR}"
    RESULT_VARIABLE _e2e_result ERROR_VARIABLE _e2e_error)
if(NOT _e2e_result EQUAL 0)
    message(FATAL_ERROR "Native E2E connection overlay: ${_e2e_error}")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_e2e_generator}" "${_e2e_header}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_dual_baseline}")
foreach(_dual_target iec61850 iec61850-shared)
    if(TARGET ${_dual_target})
        get_target_property(_dual_sources ${_dual_target} SOURCES)
        get_target_property(_dual_dir ${_dual_target} SOURCE_DIR)
        set(_dual_replaced "")
        foreach(_dual_source IN LISTS _dual_sources)
            if(_dual_source MATCHES "[/\\](acse|iso_session|iso_presentation|iso_client_connection|iso_connection|iso_server|mms_association_service)\\.c$" OR
               (CCLI_MMS_TSP_CLIENT_PROFILE AND _dual_source MATCHES "[/\\](mms_client_initiate|mms_client_connection)\\.c$"))
                get_filename_component(_dual_filename "${_dual_source}" NAME)
                if(CCLI_MMS_TSP_CLIENT_PROFILE AND _dual_filename MATCHES "^mms_client_(initiate|connection)\\.c$")
                    list(APPEND _dual_replaced "${_dual_base_output}/${_dual_filename}")
                else()
                    list(APPEND _dual_replaced "${_dual_output}/${_dual_filename}")
                endif()
            elseif(IS_ABSOLUTE "${_dual_source}" OR _dual_source MATCHES "^\\$<")
                list(APPEND _dual_replaced "${_dual_source}")
            else()
                list(APPEND _dual_replaced "${_dual_dir}/${_dual_source}")
            endif()
        endforeach()
        set_property(TARGET ${_dual_target} PROPERTY SOURCES "${_dual_replaced}")
        target_include_directories(${_dual_target} PRIVATE "${CCLI_LIBIEC61850_DIR}/src/mms/iso_client" "${CCLI_LIBIEC61850_DIR}/src/mms/iso_server")
        # Every library unit must use the same extended private presentation
        # structure, including headers that include it from the vendor directory.
        if(MSVC)
            target_compile_options(${_dual_target} PRIVATE "/FI${_dual_output}/iso_presentation.h")
        else()
            target_compile_options(${_dual_target} PRIVATE -include "${_dual_output}/iso_presentation.h")
        endif()
    endif()
endforeach()

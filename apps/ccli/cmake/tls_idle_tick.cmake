set(_CCLI_TLS_IDLE_DIR "${CMAKE_CURRENT_LIST_DIR}")
function(ccli_tls_idle_tick target filename protocol)
    if(NOT TARGET ${target})
        return()
    endif()
    get_target_property(_sources ${target} SOURCES)
    get_target_property(_source_dir ${target} SOURCE_DIR)
    set(_replacement "")
    set(_matches 0)
    foreach(_source IN LISTS _sources)
        if(_source MATCHES "[/\\]${filename}$")
            math(EXPR _matches "${_matches} + 1")
            if(IS_ABSOLUTE "${_source}")
                set(_original "${_source}")
            else()
                set(_original "${_source_dir}/${_source}")
            endif()
            get_filename_component(_original_dir "${_original}" DIRECTORY)
            set(_generated "${CMAKE_BINARY_DIR}/generated/tls/${protocol}/${filename}")
            file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/generated/tls/${protocol}")
            configure_file("${_original}" "${_generated}" COPYONLY)
            execute_process(COMMAND "${Python3_EXECUTABLE}"
                "${_CCLI_TLS_IDLE_DIR}/tls_idle_tick.py" "${_generated}" "${protocol}"
                RESULT_VARIABLE _result)
            if(NOT _result EQUAL 0)
                message(FATAL_ERROR "TLS idle timer integration failed")
            endif()
            list(APPEND _replacement "${_generated}")
            target_include_directories(${target} PRIVATE "${_original_dir}"
                "${_CCLI_TLS_IDLE_DIR}/../adapters/security")
        elseif(IS_ABSOLUTE "${_source}" OR _source MATCHES "^\\$<")
            list(APPEND _replacement "${_source}")
        else()
            list(APPEND _replacement "${_source_dir}/${_source}")
        endif()
    endforeach()
    if(NOT _matches EQUAL 1)
        message(FATAL_ERROR "Review TLS idle timer source for ${target}: expected one ${filename}")
    endif()
    set_property(TARGET ${target} PROPERTY SOURCES "${_replacement}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${_CCLI_TLS_IDLE_DIR}/tls_idle_tick.py")
endfunction()


YAHOO.namespace("caf.table");

YAHOO.caf.table.CURRENT_PROCESS_INDEX="currentProcessIndex";


YAHOO.caf.table.addRowAtTop = function(){
	
	var table = arguments[0];
	var data = arguments[1];
	YAHOO.caf.table.addRow(table,data, 0); 
	
};

YAHOO.caf.table.addRowAtBottom = function(){
	var table = arguments[0];
	var data = arguments[1];
	YAHOO.caf.table.addRow(table,data, table.getRecordSet().getRecords().length); 
	
};

YAHOO.caf.table.addRow = function(){
	var table = arguments[0];
	var data = arguments[1];
	var index = arguments[2];
	table.addRow(data, index); 
};

YAHOO.caf.table.updateRow = function(){
	
	var table = arguments[0];
	var data = arguments[1];
	var index = arguments[2];
	
	table.updateRow(index,data); 
	//alert('update'+data);
};

YAHOO.caf.table.deleteRowAtTop = function(){
	var table = arguments[0];
	YAHOO.caf.table.deleteRow(table,0); 
	
};

YAHOO.caf.table.deleteRowAtBottom = function(){
	var table = arguments[0];
	YAHOO.caf.table.deleteRow(table,table.getRecordSet().getRecords().length); 
};

YAHOO.caf.table.deleteRow = function(){
	var table = arguments[0];
	var index = arguments[1];
	table.deleteRow(index); 
};




/***
 * 窗口确定按钮中取得窗口中的数据
 * 参数1 table 表格定义
 * 参数2 页面html对象名称前缀
 */
YAHOO.caf.table.getFormDataByTableMapping=function(){
	var mnp = '';
	var table = arguments[0];
	if (!table){
		return;
	}
	var columns=table.getColumnSet().getDefinitions();
	var tempa = arguments[1];
	if (tempa&&tempa!=''){
		mnp=tempa;
	}
	//alert(mnp);
	var data=new Object();

	for (var i=0;i<columns.length;i++){
		//alert(items);
		var key= columns[i]["key"];
		var elName=mnp==''?key:mnp+key;
	//	alert(elName);
		var  el =document.getElementsByName(elName);
		if (el){
			if (el.length == 1){
				//alert(elName+':'+oRecordData[items]+el.innerHTML);
				if (el[0].value){
					
					data[key]=el[0].value;
				}else{
					data[key]='';
				}
			}else{
				var cv = YAHOO.caf.utils.getCheckBoxValue(elName);
				var str='';
				var append =false;
				if (cv.checkedValue.length>0){
					for(var j =0;j<cv.checkedValue.length;j++){
						if (append){
							str+=','+cv.checkedValue[j];
						}else{
							str+= cv.checkedValue[j];
							append=true;
						}
					}
				}
				data[key]=str;
			}
			
		}else{
			data[key]=null;
		}
	}
	//var data = buildData(name,age,name1);
	//alert('123123'+YAHOO.lang.dump(data));
	return data;
};


/***
 * 将列表中的记录同步到html对象中
 */
/***
 * 弹出窗口时 将列表数据同步到窗口中
 * 参数1 列表record 对象 
 * 参数 2 页面对象名称前缀XXX.
 *会根据record对象中列名称 查找页面对象并赋值。
 */
YAHOO.caf.table.recordData2Html =function(){
	var mnp = '';
	var oRecord = arguments[0];
	if (!oRecord){
		return;
	}
	var tempa = arguments[1];
	if (tempa&&tempa!=''){
		mnp=tempa;
	}
	//alert(mnp);
	var oRecordData = oRecord.getData();
	for (items in oRecordData){
		//alert(items);
		var elName=mnp==''?items:mnp+items;
		//alert(elName);
		var  el =document.getElementsByName(elName);
		if (el){
			if (el.length == 1){
				//alert(elName+':'+oRecordData[items]+el.innerHTML);
				if (oRecordData[items]){
					
					el[0].value= oRecordData[items];
				}else{
					el[0].value='';
				}
			}else{
				YAHOO.caf.utils.setUnChecked(elName);
				if (oRecordData[items]){
					YAHOO.caf.utils.setChecked(elName,oRecordData[items]);
				}
			}
			
		}
	}

};





/**
 * 提交整个表格中的数据
 */
YAHOO.caf.table.submitFormAndTableDatas= function(){


	
	var form;
	var table;
	var tablePrefix;	
 	var actionurl;

   	if (arguments[0]){
   		actionurl=arguments[0];
    }else{
		return;
    }
	
    if (arguments[1]){
    	form=arguments[1];
    }
    if (arguments[2]){
    	table=arguments[2];
    }
    if (arguments[3]){
    	tablePrefix=arguments[3];
    }else{
    	tablePrefix='';
    }

	//alert(form);
	//alert(table.getRecordSet());
	var stra= new StrAccumulator();
	stra.setSplit('&');

    var recordSetUrls=null;
    if(table!=null){
    	recordSetUrls = YAHOO.caf.table.recordSetToParametersUrl(table.getRecordSet(),tablePrefix); 
    }
  
     var formToParasUrl=YAHOO.caf.utils.formToParametersUrl(form);  // alert(recordArray.length);
  
     	if (formToParasUrl!=''){
   		stra.append(formToParasUrl);
   	}	  
 	if (recordSetUrls!=''){
 		stra.append(recordSetUrls);
   	}
   	actionurl=actionurl+'?'+stra.getString();
   //	alert(actionurl);
	YAHOO.caf.utils.postSubmit(actionurl);
};


/***
 * 将一个recordSet对象中的所有record对象属性值生成一个url
 */
YAHOO.caf.table.recordSetToParametersUrl=function(){
	
	var recordSet= arguments[0];
	if (!recordSet){
		return '';
	}
	var prefix= arguments[1];
	if (!prefix){
		prefix='';
	}
	
	var stra= new StrAccumulator();
	stra.setSplit('&');
	
	  var recordArray = recordSet.getRecords(); 
 	  // alert(recordArray.length);
 	   var v='';
 	 //  alert(YAHOO.lang.dump(stra));
 	   for (var i=0;i<recordArray.length;i++){
 		   var record = recordArray[i];
 		   for (items in record.getData()){
 			//   alert((prefix+items+'='));
 			   stra.append((prefix+items+'=')+(record.getData(items)?record.getData(items):''));
 			}	
 	   }
	return stra.getString();

};

/***
 * 
 *script 
 			config对象 
 			{
 				debug:false,
				 action:'/sample/dt/addUpdRowTableUpd.action',
				 table:table,
				 prefix:'',
				 index:列表中新建行的id 默认是选中行的id
				 confirm:true,
				 confirmMessage:'确定添加记录 ?'
				 postProcess:function(){formdialog.hide();}//方法调用最后调用
				 preProcess:function(){formdialog.hide();}//方法调用最前调用
				 prePostProcess: newdata,data //数据库添加数据完毕后调用 更新类表中数据的主键
				 参数一 返回添加数据，参数二 列表记录 
				 var addAfter = function(){
					  	var response=arguments[0];
					  	var data=arguments[1];
					
					  	 var newdata = YAHOO.lang.JSON.parse(response);
					
					 	//alert("newdata"+YAHOO.lang.dump(newdata["model"]));
					 	//alert((newdata["model"])["id"]);
					  	data["id"]=(newdata["model"])["id"];
					 	//alert("new data"+YAHOO.lang.dump(data));
				}
			 } 
 
 */
YAHOO.caf.table.tableAdd = function(){
  	var config=arguments[0];
	
  	if (config.debug==undefined){
		config.debug=false;
	}
	if(config.debug){	
		alert('config.debug'+config.debug);
	}
	
  	if (!config){
		return;
	}

	if(config.debug){	
		alert('config'+config);
	}
  	
	if (config.table==undefined){
		return;
	}
	if(config.debug){	
		alert('config.table'+config.table);
	}
  	
	
	if (config.confirm==undefined){
		config.confirm=true;
	}
	

	if (!config.prefix){
		config.prefix='';
	}
	
	if (!config.confirmMessage){
		config.confirmMessage='确定添加记录 ?';
	}
	if(config.debug){	
		alert('config.confirmMessage'+config.confirmMessage);
	}
	if (config.index==undefined){
		if (config.table[YAHOO.caf.table.CURRENT_PROCESS_INDEX]!=undefined){
			config.index=YAHOO.caf.table.getCurrentProcessIndex(config.table);
		}else{
			config.index = 0;
		}
	}
	if(config.debug){	
		alert('config.preProcessBefore');
	}
	if (config.preProcess!=undefined){
		config.preProcess();
	}

	
	 var data = YAHOO.caf.table.getFormDataByTableMapping(config.table,config.prefix);

	 var datastr=YAHOO.caf.utils.serial(data);
		if(config.debug){	
			alert(YAHOO.lang.dump( datastr));
		}
	var ajaxUpdateHandleSuccess = function(o){ 
		if(o.responseText !== undefined){ 
		//	alert(YAHOO.lang.dump( o.responseText));
			if (config.prePostProcess!=undefined){
					var newObj=YAHOO.lang.JSON.parse(o.responseText);
					config.prePostProcess(newObj,data);
			}	
			if(config.debug){	
				alert("ajaxUpdateHandleSuccess new data"+YAHOO.lang.dump(data));
			}
			YAHOO.caf.table.addRow(config.table,data,config.index);
			YAHOO.caf.table.setCurrentProcessIndex(config.table,YAHOO.caf.table.getTableSelectRowIndex(config.table));
		
		}else{
			if(config.debug){
				alert('ajaxAddHandleSuccess Failure');
			}
		}
	}; 
		
	var ajaxUpdateHandleFailure = function(o){ 
		if(config.debug){
			alert('ajaxUpdateHandleFailure');
		}
	};		

	var callback = { 
		success:ajaxUpdateHandleSuccess,
		failure:ajaxUpdateHandleFailure, 
		argument: {}, 
		timeout: 10000 
	}; 
	var request;

	if (config.confirm){
	
		if(confirm(config.confirmMessage)) {
			
			if (config.action==undefined){
				YAHOO.caf.table.addRow(config.table,data,config.index);
				//操作完成后要更新列表被选中记录的值
				YAHOO.caf.table.setCurrentProcessIndex(config.table,YAHOO.caf.table.getTableSelectRowIndex(config.table));
			}else{
				request=YAHOO.util.Connect.asyncRequest('POST', config.action, callback, datastr);
			}
			if(config.debug){
				alert("Initiating request; tId: " + request.tId + ".", "info", "example"); 
			}
		//	formdialog.hide();
	  	}else{
	  		return;
	  	}
	}else{
		if (config.action==undefined){
			YAHOO.caf.table.addRow(config.table,data,config.index);
		}else{
			request=YAHOO.util.Connect.asyncRequest('POST', config.action, callback, datastr);
		}
		if(config.debug){
			alert("Initiating request; tId: " + (request ? request.tId : '') + ".", "info", "example"); 
		}	
		
	}
	if (config.postProcess!=undefined){
		config.postProcess();
	}
};




/***
 * 

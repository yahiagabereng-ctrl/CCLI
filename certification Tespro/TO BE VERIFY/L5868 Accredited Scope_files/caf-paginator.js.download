		Paginator.ui.PageGoto = function (p) {
		    this.paginator = p;

		    p.subscribe('recordOffsetChange',this.update,this,true);
		    p.subscribe('rowsPerPageChange',this.update,this,true);
		    p.subscribe('totalRecordsChange',this.update,this,true);
		    p.subscribe('destroy',this.destroy,this,true);

		};

		/**
		 * Decorates Paginator instances with new attributes. Called during
		 * Paginator instantiation.
		 * @method init
		 * @param p {Paginator} Paginator instance to decorate
		 * @static
		 */
		Paginator.ui.PageGoto.init = function (p) {

		    /**
		     * Used as innerHTML for the first page link/span.
		     * @attribute firstPageLinkLabel
		     * @default '&lt;&lt;&nbsp;first'
		     */
		    p.setAttributeConfig('pageGotoLabel', {
		        value : '',
		        validator : l.isNumber
		    });

		    /**
		     * CSS class assigned to the link/span
		     * @attribute firstPageLinkClass
		     * @default 'yui-pg-first'
		     */
		    p.setAttributeConfig('pageGotoClass', {
		        value : 'yui-pg-pageGoto',
		        validator : l.isString
		    });
		};

		// Instance members and methods
		Paginator.ui.PageGoto.prototype = {

		   
		    input      : null,

		    /**
		     * Generate the nodes and return the appropriate node given the current
		     * pagination state.
		     * @method render
		     * @param id_base {string} used to create unique ids for generated nodes
		     * @return {HTMLElement}
		     */
		    render : function (id_base) {
		        var p     = this.paginator,
		            c     = p.get('pageGotoClass'),
		            label = p.get('pageGotoLabel');


		        this.input     = document.createElement('input');

		        

		        this.input.id        = id_base + '-pageGoto-input';
		        this.input.className = c;
		        this.input.value = (p.getPageRecords() ? p.getCurrentPage() : 0);
		    //    YAHOO.util.Event.on(this.input,'keydown',this.onClick,this,true);
		        YAHOO.util.Event.addListener(this.input, "keydown",this.onClick,this,true);
		        return this.input;
		    },

		    /**
		     * Swap the link and span nodes if appropriate.
		     * @method update
		     * @param e {CustomEvent} The calling change event
		     */
		    update : function (e) {
		        if (e && e.prevValue === e.newValue) {
		            return;
		        }
		        var p     = this.paginator;
		        this.input.value = (p.getPageRecords() ? p.getCurrentPage() : 0);
		    },

		    /**
		     * Removes the link/span node and clears event listeners
		     * removal.
		     * @method destroy
		     * @private
		     */
		    destroy : function () {
		        YAHOO.util.Event.purgeElement(this.input);
		       this.input = null;
		    },

		    /**
		     * Listener for the link's onclick event.  Pass new value to setPage method.
		     * @method onClick
		     * @param e {DOMEvent} The click event
		     */
		    onClick : function (e) {
		    	  // this.paginator.setPage(this.paginator.getPreviousPage());
		    	var event = e;
		    	var currentKey = event.charCode || event.keyCode; //IE、FF下获取键盘码
				var type = window.event ? 0 : 1; // 0 ie 1 ff
				var element = event.srcElement || event.target;
				var value = element.value;
				if (currentKey==13){
					var go=value-0;
					if (go>(this.paginator.getTotalPages())){
						go=(this.paginator.getTotalPages());
						value=this.paginator.getTotalPages();
					}else if(go==0){
						value=1;
						go=1;
					}
					 var a=this.paginator.get('agentMethod');
				     if (a){
					     a(this.paginator,e,this.paginator.setPage,go);
				     }else{
				          this.paginator.setPage(go);
				     }
				}else{
					if (!((currentKey >= 48 && currentKey <= 57) || (currentKey >= 96 && currentKey <= 105) || (currentKey == 8))) {
						if (type == 0) { //IE
							event.returnValue = false; //e.returnValue = false;效果相同.
						}else {//Firefox
							event.preventDefault();
						}
						return;
					}
				}
		    	
		    	
		       
		    }
		};
		
	
		

 * @private
 */
current   : null,

/**
 * Link node
 * @property link
 * @type HTMLElement
 * @private
 */
link      : null,

/**
 * Span node (inactive link)
 * @property span
 * @type HTMLElement
 * @private
 */
span      : null,

/**
 * Generate the nodes and return the appropriate node given the current
 * pagination state.
 * @method render
 * @param id_base {string} used to create unique ids for generated nodes
 * @return {HTMLElement}
 */
render : function (id_base) {
    var p     = this.paginator,
        c     = p.get('endIndexClass'),
        label = p.get('endIndexLabel');
    records = p.getPageRecords();
    this.span     = document.createElement('span');
    this.span.id        = id_base + '-endIndex-span';
    this.span.className = c;
    this.span.innerHTML =''+ (records ? records[1] : 0)+'';

    this.current =this.span;
    return this.current;
},

/**
 * Swap the link and span nodes if appropriate.
 * @method update
 * @param e {CustomEvent} The calling change event
 */
update : function (e) {
    if (e && e.prevValue === e.newValue) {
        return;
    }
    var p     = this.paginator;
    records = p.getPageRecords();
    var par = this.current ? this.current.parentNode : null;
  
        if (par && this.current === this.span) {
//            par.replaceChild(this.span,this.current);
//            this.current = this.span;
        	var obj = document.getElementById(this.span.id);
           
        	obj.innerHTML =''+(records ? records[1] : 0)+'';
        }
 
       
    
},

/**
 * Removes the link/span node and clears event listeners
 * removal.
 * @method destroy
 * @private
 */
destroy : function () {
  // YAHOO.util.Event.purgeElement(this.link);
    this.current.parentNode.removeChild(this.current);
    this.link = this.span = null;
},

/**
 * Listener for the link's onclick event.  Pass new value to setPage method.
 * @method onClick
 * @param e {DOMEvent} The click event
 */
onClick : function (e) {
    YAHOO.util.Event.stopEvent(e);
  //  this.paginator.setPage(1);
}
};



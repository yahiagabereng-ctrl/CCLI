ngth;e++){if(c.options[e].selected){if(c.options[e].value!=""){a.append(c.name+"="+c.options[e].value)}}}}}}}return a.getString()};var StrAccumulator=function(){this._hasAppend=false;this.string="";this.split="";this.count=0;StrAccumulator.prototype.getCount=function(){return this.count};StrAccumulator.prototype.hasAppend=function(){return this._hasAppend};StrAccumulator.prototype.getString=function(){return this.string};StrAccumulator.prototype.getSplit=function(){return this.split};StrAccumulator.prototype.setSplit=function(){if(arguments[0]){this.split=arguments[0]}};StrAccumulator.prototype.reset=function(){this._hasAppend=false;this.string="";this.split="";this.count=0};StrAccumulator.prototype.append=function(){var b;var a;if(arguments.length>=1){if(arguments[0]){b=arguments[0]}}if(arguments.length>=1){if(arguments[1]){a=arguments[1]}}if(!a){a=false}if(a){this.count++;if(this._hasAppend){this.string+=this.split+(b==null?"":b)}else{this.string+=b==null?"":b;this._hasAppend=true}}else{if(b&&b!=""){this.count++;
if(this._hasAppend){this.string+=this.split+(b==null?"":b)}else{this.string+=b==null?"":b;this._hasAppend=true}}}}};
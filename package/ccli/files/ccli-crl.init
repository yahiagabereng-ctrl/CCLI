#!/bin/sh /etc/rc.common
START=96
STOP=09
USE_PROCD=1

start_service() {
    local enabled issuers state interval retry
    config_load ccli-crl
    config_get_bool enabled main enabled 0
    [ "$enabled" = 1 ] || return 0
    config_get issuers main issuers /etc/ccli/crl-issuers.conf
    config_get state main state /etc/ccli/crl-pull
    config_get interval main interval 3600
    config_get retry main retry 60
    procd_open_instance
    procd_set_param command /usr/sbin/ccli-crl-worker "$issuers" "$state" "$interval" "$retry"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger ccli-crl
}

#!/bin/sh
# Foreground procd worker; retry failures without restarting plant control.
set -eu
[ "$#" -eq 4 ] || exit 2
config=$1 state=$2 interval=$3 retry=$4
case "$interval:$retry" in *[!0-9:]*) exit 2;; esac
[ "$interval" -ge 60 ] && [ "$interval" -le 86400 ] || exit 2
[ "$retry" -ge 5 ] && [ "$retry" -le 3600 ] || exit 2
sleeper=
stop() { [ -z "$sleeper" ] || kill "$sleeper" 2>/dev/null || :; exit 0; }
trap stop TERM INT
while :; do
    if /usr/sbin/ccli-crl-refresh "$config" "$state"; then delay=$interval; else delay=$retry; fi
    sleep "$delay" &
    sleeper=$!
    wait "$sleeper" || :
    sleeper=
done

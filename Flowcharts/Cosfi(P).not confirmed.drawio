        <UserObject label="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;DEFINITIONS&lt;br&gt;────────────────&lt;br&gt;cosφ_calculated, piecewise:&lt;br&gt;P≤P_A → cosφ_A&lt;br&gt;P_A&amp;lt;P&amp;lt;P_B → cosφ_A + (P−P_A)/(P_B−P_A)×(cosφ_B−cosφ_A)&lt;br&gt;P_B≤P&amp;lt;P_C → cosφ_B + (P−P_B)/(P_C−P_B)×(cosφ_C−cosφ_B)&lt;br&gt;P≥P_C → cosφ_C&lt;br&gt;────────────────&lt;br&gt;cosφ_internal_sp:&lt;br&gt;state variable = currently active setpoint;&lt;br&gt;updated only when the trigger fires,&lt;br&gt;otherwise retains its prior value&lt;/font&gt;&lt;/b&gt;" mermaidId="n:DEF" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=#fff8e1;strokeColor=#b8860b;fontColor=#5a4600;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="DEFINITIONS&#xa;────────────────&#xa;cosφ_calculated, piecewise:&#xa;P≤P_A → cosφ_A&#xa;P_A&amp;lt;P&amp;lt;P_B → cosφ_A + (P−P_A)/(P_B−P_A)×(cosφ_B−cosφ_A)&#xa;P_B≤P&amp;lt;P_C → cosφ_B + (P−P_B)/(P_C−P_B)×(cosφ_C−cosφ_B)&#xa;P≥P_C → cosφ_C&#xa;────────────────&#xa;cosφ_internal_sp:&#xa;state variable = currently active setpoint;&#xa;updated only when the trigger fires,&#xa;otherwise retains its prior value" id="31">
          <mxCell parent="56" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=#fff8e1;strokeColor=#b8860b;fontColor=#5a4600;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="265" width="2770" x="761.83" y="1953" as="geometry" />
          </mxCell>
        </UserObject>

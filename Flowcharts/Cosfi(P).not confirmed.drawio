        <UserObject label="&#xa;&lt;b style=&quot;forced-color-adjust: none; color: rgb(27, 61, 30); font-family: &amp;quot;Trebuchet MS&amp;quot;, Verdana, Arial, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(236, 236, 236); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;font style=&quot;forced-color-adjust: none; font-size: 20px;&quot;&gt;α adjustable&lt;/font&gt;&lt;/b&gt;&#xa;&#xa;" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  layout: elk\n---\nflowchart TD\n    subgraph EXT[\&quot;WRITTEN BY DSO / OPERATOR — configuration, not live values\&quot;]\n        direction TB\n        PA[\&quot;P_A = 0.20×Pn\&quot;]\n        CA[\&quot;cosφ_A = 1.00\&quot;]\n        PB[\&quot;P_B = 0.50×Pn\&quot;]\n        CB[\&quot;cosφ_B = 1.00\&quot;]\n        PC[\&quot;P_C = 1.00×Pn\&quot;]\n        CC[\&quot;cosφ_C = 0.95\&quot;]\n        VLI[\&quot;Voltage lock-in = 1.05×Vn\&quot;]\n        VLO[\&quot;Voltage lock-out = 0.98×Vn\&quot;]\n    end\n\n    subgraph MEAS[\&quot;MEASURED LOCALLY BY CCI — not sent by DSO\&quot;]\n        direction TB\n        MP[\&quot;P at POC&lt;br/&gt;200ms cadence, MC200 (O.7.4)\&quot;]\n        MV[\&quot;V at PdC\&quot;]\n    end\n\n    GATE{\&quot;V within lock-in/lock-out band?&lt;br/&gt;0.98 ≤ V ≤ 1.05\&quot;}\n    INACTIVE([\&quot;Function inactive —&lt;br/&gt;no action this cycle\&quot;])\n\n    SEG{\&quot;Which zone is P in?\&quot;}\n    Z1[\&quot;Zone 1: P ≤ P_A — saturated&lt;br/&gt;cosφ_calculated = cosφ_A\&quot;]\n    Z2[\&quot;Zone 2: P_A &lt; P &lt; P_B&lt;br/&gt;interpolate A→B\&quot;]\n    Z3[\&quot;Zone 3: P_B ≤ P &lt; P_C&lt;br/&gt;interpolate B→C\&quot;]\n    Z4[\&quot;Zone 4: P ≥ P_C — saturated&lt;br/&gt;cosφ_calculated = cosφ_C\&quot;]\n\n    TRIGGER{\&quot;&amp;#124;cosφ_calculated − cosφ_internal_sp&amp;#124; ≥ δcosφ?&lt;br/&gt;δcosφ = α = 0.02\&quot;}\n    OUT1([\&quot;Update cosφ_internal_sp\&quot;])\n    OUT2([\&quot;Hold previous setpoint\&quot;])\n\n    DEF[\&quot;DEFINITIONS&lt;br/&gt;────────────────&lt;br/&gt;cosφ_calculated, piecewise:&lt;br/&gt;P≤P_A → cosφ_A&lt;br/&gt;P_A&amp;lt;P&amp;lt;P_B → cosφ_A + (P−P_A)/(P_B−P_A)×(cosφ_B−cosφ_A)&lt;br/&gt;P_B≤P&amp;lt;P_C → cosφ_B + (P−P_B)/(P_C−P_B)×(cosφ_C−cosφ_B)&lt;br/&gt;P≥P_C → cosφ_C&lt;br/&gt;────────────────&lt;br/&gt;cosφ_internal_sp:&lt;br/&gt;state variable = currently active setpoint;&lt;br/&gt;updated only when the trigger fires,&lt;br/&gt;otherwise retains its prior value\&quot;]\n\n    subgraph FASTRING[\&quot;FAST RING — applied to the plant (Figure 123)\&quot;]\n        direction TB\n        GRAD[\&quot;Check gradient &amp;amp; limitation at POC&lt;br/&gt;ramp toward target if step is too large\&quot;]\n        REGQ{\&quot;Does inverter accept&lt;br/&gt;a native cosφ register?\&quot;}\n        WRCOS[\&quot;Write cosφ setpoint&lt;br/&gt;to inverter&#39;s cosφ register&lt;br/&gt;(vendor-scaled, e.g. ±1000 = ±1.00)\&quot;]\n        CONV[\&quot;Convert to Q:&lt;br/&gt;Q_target = P_measured × tan(arccos(cosφ_internal_sp))&lt;br/&gt;sign = leading/lagging\&quot;]\n        WRQ[\&quot;Write Q_target&lt;br/&gt;to inverter&#39;s Q register\&quot;]\n        MODBUS([\&quot;Modbus TCP/RTU write&lt;br/&gt;function code 0x06 / 0x10&lt;br/&gt;to inverter (CCI = master)\&quot;])\n    end\n\n    EXT ==&gt;|\&quot;config values\&quot;| GATE\n    EXT ==&gt;|\&quot;config values\&quot;| SEG\n    MV --&gt; GATE\n    MP --&gt; SEG\n\n    GATE --&gt;|\&quot;no\&quot;| INACTIVE\n    GATE --&gt;|\&quot;yes\&quot;| SEG\n\n    SEG --&gt;|\&quot;zone 1\&quot;| Z1\n    SEG --&gt;|\&quot;zone 2\&quot;| Z2\n    SEG --&gt;|\&quot;zone 3\&quot;| Z3\n    SEG --&gt;|\&quot;zone 4\&quot;| Z4\n\n    Z1 --&gt; TRIGGER\n    Z2 --&gt; TRIGGER\n    Z3 --&gt; TRIGGER\n    Z4 --&gt; TRIGGER\n\n    TRIGGER --&gt;|\&quot;yes\&quot;| OUT1\n    TRIGGER --&gt;|\&quot;no\&quot;| OUT2\n    TRIGGER -.-&gt;|\&quot;reference\&quot;| DEF\n\n    OUT1 --&gt; GRAD\n    GRAD --&gt; REGQ\n    REGQ --&gt;|\&quot;yes\&quot;| WRCOS\n    REGQ --&gt;|\&quot;no\&quot;| CONV\n    CONV --&gt; WRQ\n    WRCOS --&gt; MODBUS\n    WRQ --&gt; MODBUS\n\n    classDef ext fill:#fde2e2,stroke:#b3261e,color:#601410;\n    classDef meas fill:#e2f0fd,stroke:#1a5fb4,color:#0b2e4f;\n    classDef comp fill:#e8f5e9,stroke:#2e7d32,color:#1b3d1e;\n    classDef def fill:#fff8e1,stroke:#b8860b,color:#5a4600,text-align:left;\n    classDef ring fill:#f3e8fd,stroke:#7a3fb8,color:#3d1a5c;\n    class PA,CA,PB,CB,PC,CC,VLI,VLO ext;\n    class MP,MV meas;\n    class GATE,SEG,Z1,Z2,Z3,Z4,TRIGGER,OUT1,OUT2,INACTIVE comp;\n    class DEF def;\n    class GRAD,REGQ,WRCOS,CONV,WRQ,MODBUS ring;\n    style EXT fill:#fff1f1,stroke:#b3261e;\n    style MEAS fill:#eef6ff,stroke:#1a5fb4;\n    style FASTRING fill:#faf5ff,stroke:#7a3fb8;\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="56">

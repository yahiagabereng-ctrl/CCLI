          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="o" value="on restoration" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fallback" target="restore">
          <mxGeometry relative="1" as="geometry">

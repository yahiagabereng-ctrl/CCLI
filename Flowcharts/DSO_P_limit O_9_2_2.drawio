<mxfile host="Electron" pages="3">
  <diagram id="online" name="1 - DSO P limit function">
    <mxGraphModel dx="3644" dy="841" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="2130" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=20;fontColor=#253044;spacing=10;" value="&lt;b&gt;O.9.2.2 | Active-power injection limit commanded by the DSO&lt;/b&gt;&lt;br&gt;Slaved CCI function at PdC · same ceiling interface as O.9.2.1 · offline User procedure on page 2" vertex="1">
          <mxGeometry height="82" width="1720" x="35" y="20" as="geometry" />
        </mxCell>
        <mxCell id="user" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fontColor=#253044;spacing=10;;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" value="&lt;b&gt;ACCEPTED DSO COMMAND / STORED STATE&lt;/b&gt;&lt;br&gt;A: enabled; L: accepted ceiling in kW.&lt;br&gt;Activate with valid L: A ← 1.&lt;br&gt;Accepted limit update: L ← L&lt;sub&gt;req&lt;/sub&gt;.&lt;br&gt;Release: A ← 0; no new command: retain state." vertex="1">
          <mxGeometry height="140" width="435" x="30" y="137.5" as="geometry" />
        </mxCell>
        <mxCell id="params" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fontColor=#253044;spacing=10;;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" value="&lt;b&gt;PLANT CONFIGURATION&lt;/b&gt;&lt;br&gt;P&lt;sub&gt;n,plant&lt;/sub&gt;, command scaling and unit capabilities:&lt;br&gt;&lt;b&gt;configurable from approved plant data.&lt;/b&gt;&lt;br&gt;Received DSO threshold is an operating command." vertex="1">
          <mxGeometry height="150" width="435" x="30" y="297" as="geometry" />
        </mxCell>
        <mxCell id="meter" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fontColor=#253044;spacing=10;;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" value="&lt;b&gt;DSO COMMAND VALIDATION&lt;/b&gt;&lt;br&gt;Validate authority, operation, units and range.&lt;br&gt;&lt;b&gt;Δt = t&lt;sub&gt;now&lt;/sub&gt; − t&lt;sub&gt;last&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;Accept setpoint timing if no prior processed setpoint&lt;br&gt;or Δt ≥ 3 s; otherwise reject (O.7.3.3)." vertex="1">
          <mxGeometry height="145" width="435" x="10" y="470" as="geometry" />
        </mxCell>
        <mxCell id="note1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=2;fontSize=15;fontColor=#253044;spacing=10;" value="&lt;b&gt;VARIABLES / IMPLEMENTATION CONVENTION&lt;/b&gt;&lt;br&gt;A ∈ {0,1}: active state; L: stored ceiling in kW.&lt;br&gt;Positive P = injection at PdC.&lt;br&gt;Superscript ⁺ = value after command processing.&lt;br&gt;P&lt;sub&gt;base&lt;/sub&gt;: requested power before active P ceilings." vertex="1">
          <mxGeometry height="152" width="480" x="1770" y="137.5" as="geometry" />
        </mxCell>
        <mxCell id="note2" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=2;fontSize=15;fontColor=#253044;spacing=10;" value="&lt;b&gt;ACCEPTED STATE UPDATE&lt;/b&gt;&lt;br&gt;Value update: L⁺ = L&lt;sub&gt;req&lt;/sub&gt;; otherwise L⁺ = L.&lt;br&gt;Activate: A⁺ = 1; release: A⁺ = 0;&lt;br&gt;otherwise A⁺ = A.&lt;br&gt;Processed setpoint: t&lt;sub&gt;last&lt;/sub&gt;⁺ = t&lt;sub&gt;now&lt;/sub&gt;;&lt;br&gt;otherwise retain t&lt;sub&gt;last&lt;/sub&gt;." vertex="1">
          <mxGeometry height="175" width="480" x="1770" y="317" as="geometry" />
        </mxCell>
        <mxCell id="enable" parent="1" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=16;fontColor=#253044;spacing=10;;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" value="&lt;b&gt;DSO LIMIT ENABLED?&lt;/b&gt;&lt;br&gt;A = 1?" vertex="1">
          <mxGeometry height="105" width="540" x="570" y="155" as="geometry" />
        </mxCell>
        <mxCell id="1j3YTbN2HrMu0jg6AcCc-1" edge="1" parent="1" source="inactive" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;;strokeColor=#9673a6;dashed=1;endArrow=block;endFill=1;" target="candidate" value="disabled: no ceiling">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inactive" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=15;fontColor=#253044;spacing=10;" value="&lt;b&gt;INACTIVE — A = 0&lt;/b&gt;&lt;br&gt;No ceiling from O.9.2.2.&lt;br&gt;Other active control functions continue." vertex="1">
          <mxGeometry height="120" width="480" x="1270" y="492" as="geometry" />
        </mxCell>
        <mxCell id="valid" parent="1" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=16;fontColor=#253044;spacing=10;;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" value="&lt;b&gt;ACCEPTED CEILING USABLE?&lt;/b&gt;&lt;br&gt;Valid stored L and DSO channel available?" vertex="1">
          <mxGeometry height="105" width="540" x="570" y="355" as="geometry" />
        </mxCell>
        <mxCell id="fault" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fontColor=#253044;spacing=10;;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" value="&lt;b&gt;CHANNEL LOSS / NO USABLE CEILING&lt;/b&gt;&lt;br&gt;Channel loss: apply agreed delay and fallback; see page 2.&lt;br&gt;Invalid command: reject, preserve valid state.&lt;br&gt;No valid ceiling: do not activate this function." vertex="1">
          <mxGeometry height="160" width="480" x="1270" y="650" as="geometry" />
        </mxCell>
        <mxCell id="hysteresis" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fontColor=#253044;spacing=10;;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" value="&lt;b&gt;OBTAIN THE DSO POWER CEILING&lt;/b&gt;&lt;br&gt;L = accepted DSO power threshold.&lt;br&gt;If command is s% of nominal plant power:&lt;br&gt;&lt;b&gt;L = (s / 100) × P&lt;sub&gt;n,plant&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;No voltage-dependent P(V) calculation." vertex="1">
          <mxGeometry height="152" width="540" x="570" y="520" as="geometry" />
        </mxCell>
        <mxCell id="active" parent="1" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=16;fontColor=#253044;spacing=10;;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" value="&lt;b&gt;DOES THE CEILING REQUIRE LIMITATION?&lt;/b&gt;&lt;br&gt;P&lt;sub&gt;base&lt;/sub&gt; &amp;gt; L?&lt;br&gt;P&lt;sub&gt;base&lt;/sub&gt;: otherwise requested feasible injection." vertex="1">
          <mxGeometry height="106" width="540" x="570" y="730" as="geometry" />
        </mxCell>
        <mxCell id="1j3YTbN2HrMu0jg6AcCc-7" edge="1" parent="1" source="release" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="candidate">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="330" y="1312.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="release" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fontColor=#253044;spacing=10;;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" value="&lt;b&gt;CEILING CURRENTLY NON-BINDING&lt;/b&gt;&lt;br&gt;P&lt;sub&gt;base&lt;/sub&gt; ≤ L: no additional reduction.&lt;br&gt;&lt;b&gt;Keep ceiling L active.&lt;/b&gt;&lt;br&gt;Lower injection is allowed; do not force P up to L." vertex="1">
          <mxGeometry height="130" width="480" x="80" y="902" as="geometry" />
        </mxCell>
        <mxCell id="curve" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fontColor=#253044;spacing=10;;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" value="&lt;b&gt;LIMITATION REQUIRED&lt;/b&gt;&lt;br&gt;&lt;b&gt;ΔP&lt;sub&gt;curtail&lt;/sub&gt; = max(0, P&lt;sub&gt;base&lt;/sub&gt; − L)&lt;/b&gt;&lt;br&gt;Pass ceiling L to the shared resolver.&lt;br&gt;This quantity expresses the requested curtailment." vertex="1">
          <mxGeometry height="145" width="540" x="570" y="896" as="geometry" />
        </mxCell>
        <mxCell id="ramp" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fontColor=#253044;spacing=10;;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" value="&lt;b&gt;SHARED UNIT RAMP CONSTRAINT&lt;/b&gt;&lt;br&gt;&lt;b&gt;−R&lt;sub&gt;down,i&lt;/sub&gt; Δt&lt;sub&gt;c&lt;/sub&gt; ≤ P&lt;sub&gt;i,cmd&lt;/sub&gt;[k] − P&lt;sub&gt;i,cmd&lt;/sub&gt;[k−1] ≤ R&lt;sub&gt;up,i&lt;/sub&gt; Δt&lt;sub&gt;c&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;Rates: configured applicable unit gradients (kW/s).&lt;br&gt;Δt&lt;sub&gt;c&lt;/sub&gt;: control-cycle duration (s)." vertex="1">
          <mxGeometry height="145" width="540" x="570" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="candidate" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fontColor=#253044;spacing=10;;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" value="&lt;b&gt;FUNCTION OUTPUT TO O.11&lt;/b&gt;&lt;br&gt;&lt;b&gt;A = 1 → P&lt;sub&gt;DSO,cap&lt;/sub&gt; = L&lt;/b&gt;&lt;br&gt;&lt;b&gt;A = 0 → no ceiling from this function&lt;/b&gt;&lt;br&gt;Active ceiling persists even when non-binding." vertex="1">
          <mxGeometry height="132" width="540" x="570" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="log" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fontColor=#253044;spacing=10;;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" value="&lt;b&gt;STATUS / DIAGNOSTICS / LOG&lt;/b&gt;&lt;br&gt;Expose accepted ceiling and function state.&lt;br&gt;O.14: record required communication and functional diagnostics.&lt;br&gt;O.11: record priority changes." vertex="1">
          <mxGeometry height="142" width="480" x="1240" y="1430" as="geometry" />
        </mxCell>
        <mxCell id="priority" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontSize=15;fontColor=#253044;spacing=10;" value="&lt;b&gt;SHARED O.11 PRIORITY / FEASIBILITY&lt;/b&gt;&lt;br&gt;&lt;b&gt;P&lt;sub&gt;bounded&lt;/sub&gt; = min(P&lt;sub&gt;base&lt;/sub&gt;, L&lt;sub&gt;1&lt;/sub&gt;, …, L&lt;sub&gt;m&lt;/sub&gt;)&lt;/b&gt;&lt;br&gt;L&lt;sub&gt;j&lt;/sub&gt;: applicable active ceilings; none → P&lt;sub&gt;bounded&lt;/sub&gt; = P&lt;sub&gt;base&lt;/sub&gt;.&lt;br&gt;Resolve joint P/Q capability and priorities to obtain P&lt;sub&gt;ref&lt;/sub&gt;.&lt;br&gt;Default DSO limit priority: 2 when intervening." vertex="1">
          <mxGeometry height="145" width="540" x="570" y="1430" as="geometry" />
        </mxCell>
        <mxCell id="fast" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fontColor=#253044;spacing=10;;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" value="&lt;b&gt;SHARED FAST CONTROL RING&lt;/b&gt;&lt;br&gt;Track resolved P at PdC; allocate curtailment to units.&lt;br&gt;Storage absorption is possible if installed and SoC permits.&lt;br&gt;Use configured plant capabilities." vertex="1">
          <mxGeometry height="160" width="540" x="570" y="1620" as="geometry" />
        </mxCell>
        <mxCell id="feedback" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=15;fontColor=#253044;spacing=10;" value="&lt;b&gt;SHARED FAST-RING FEEDBACK&lt;/b&gt;&lt;br&gt;&lt;b&gt;e&lt;sub&gt;P&lt;/sub&gt; = P&lt;sub&gt;ref&lt;/sub&gt; − P&lt;sub&gt;PdC,MC200&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;With active ceiling: excess = max(0, P&lt;sub&gt;PdC&lt;/sub&gt; − L).&lt;br&gt;Use valid feedback; monitor tracking and ceiling excess.&lt;br&gt;The shared regulator determines unit-command corrections." vertex="1">
          <mxGeometry height="140" width="540" x="570" y="1822" as="geometry" />
        </mxCell>
        <mxCell id="note3" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fontColor=#253044;spacing=10;;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" value="&lt;b&gt;NO DSO CHANNEL — SEE PAGE 2&lt;/b&gt;&lt;br&gt;DSO may request reduction / disconnection through the Operating Rule procedure.&lt;br&gt;The User implements it on site or by remote terminal.&lt;br&gt;Automatic fallback is a separate path." vertex="1">
          <mxGeometry height="165" width="480" x="1770" y="540" as="geometry" />
        </mxCell>
        <mxCell id="note4" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=2;fontSize=15;fontColor=#253044;spacing=10;" value="&lt;b&gt;RESPONSE CRITERIA&lt;/b&gt;&lt;br&gt;O.7.3.1 fast ring: TsP ≤ 60 s, ±5% settling band.&lt;br&gt;8.8.6.3.4 commanded reduction: within 1 min; ±2.5% P&lt;sub&gt;n&lt;/sub&gt;, with the stated special band for 10% / technical minimum.&lt;br&gt;Apply the relevant test criterion." vertex="1">
          <mxGeometry height="210" width="480" x="1770" y="770" as="geometry" />
        </mxCell>

        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  layout: elk\n---\nflowchart TD\n    ORIGIN[\&quot;Command origin: DSO\nvia Eth_A interface (O.13.1.2)\nVoltage control mode iv (O.9.1.4)\&quot;] --&gt; OPST[\&quot;Operating status\nRange: 1=Operating / 5=Not-Operating\nDefault: 5\&quot;]\n\n    OPST --&gt; OPCHK{\&quot;Status = 1\n(Operating)?\&quot;}\n    OPCHK -- \&quot;No\&quot; --&gt; IDLE[\&quot;Function idle -\nno Q set-point applied\&quot;]\n    OPCHK -- \&quot;Yes\&quot; --&gt; ACT[\&quot;Activation command\nRange: 5=Inactive / 1=Active\nDefault: 5\&quot;]\n\n    ACT --&gt; ACHK{\&quot;Command = 1\n(Active)?\&quot;}\n    ACHK -- \&quot;No\&quot; --&gt; IDLE\n    ACHK -- \&quot;Yes\&quot; --&gt; FST[\&quot;Function status\nRange: 0=Not available / 2=Automatic(Priority)\nDefault: 2 - always externally driven,\nno Autonomous option\&quot;]\n\n    FST --&gt; PRIO{\&quot;Priority check - Table 1:\nthis function = index 5\n(mid priority - beats index 6 defaults\nand index 7 Aggregator Q, loses to 1-4)\&quot;}\n    PRIO -- \&quot;Higher-priority function\n(index 1-4) already active\&quot; --&gt; BLOCK[\&quot;Not activated -\nexisting function stays in control\&quot;]\n    PRIO -- \&quot;No conflicting\nhigher-priority function\&quot; --&gt; TARGET[\&quot;Feed-in / feed-out reactive power target\nRange: 0..100% of Smax (+capacitive / -inductive)\nDefault: 0 / 0\&quot;]\n\n    TARGET --&gt; NOFORM[\&quot;Trigger equation: NONE -\ndirect target tracking, no formula\n(identical to O.10.3.2, DSO-triggered instead)\&quot;]\n\n    NOFORM --&gt; DIST[\&quot;Distribute Q target across plant elements\n(method left to User / plant designer)\&quot;]\n\n    DIST --&gt; CAP{\&quot;Can plant capability\nreach requested Q?\&quot;}\n    CAP -- \&quot;No\&quot; --&gt; CLOSEST[\&quot;Bring plant to closest\nachievable Q value\&quot;]\n    CAP -- \&quot;Yes\&quot; --&gt; PUSH[\&quot;OUTPUT TO INVERTERS:\nQ_sp_new pushed across generating units\n
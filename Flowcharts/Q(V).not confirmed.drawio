        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  layout: elk\n---\nflowchart TD\n    Pn[\&quot;Plant rated active power: Pn\&quot;] --&gt; LK[\&quot;lock-in = 0.20 &amp;times; Pn&amp;#10;lock-out = 0.05 &amp;times; Pn\&quot;]\n    LK --&gt; PC{\&quot;Measured P vs thresholds\&quot;}\n    PC -- \&quot;P &amp;gt; lock-in\&quot; --&gt; ON[\&quot;Function ON\&quot;]\n    PC -- \&quot;P &amp;lt; lock-out\&quot; --&gt; OFF[\&quot;Function OFF\&quot;]\n\n    Vn[\&quot;Vn (nominal voltage), V_measured\&quot;] --&gt; VPU[\&quot;Vpu = V_measured / Vn\&quot;]\n    VPU --&gt; ZONE{\&quot;Compare Vpu to V2i, V1i, V1s, V2s\&quot;}\n    ZONE -- \&quot;Vpu &amp;le; V2i\&quot; --&gt; Z1[\&quot;K = 1&amp;#10;(saturated injection)\&quot;]\n    ZONE -- \&quot;V2i &amp;lt; Vpu &amp;le; V1i\&quot; --&gt; Z2[\&quot;K = (V1i &amp;#8722; Vpu) / (V1i &amp;#8722; V2i)\&quot;]\n    ZONE -- \&quot;V1i &amp;lt; Vpu &amp;lt; V1s\&quot; --&gt; Z3[\&quot;K = 0 (deadband)\&quot;]\n    ZONE -- \&quot;V1s &amp;le; Vpu &amp;lt; V2s\&quot; --&gt; Z4[\&quot;K = (Vpu &amp;#8722; V1s) / (V2s &amp;#8722; V1s)\&quot;]\n    ZONE -- \&quot;Vpu &amp;ge; V2s\&quot; --&gt; Z5[\&quot;K = 1&amp;#10;(saturated absorption)\&quot;]\n\n    Z1 --&gt; QC[\&quot;Q_calculated = 0 + K &amp;times; Qmax&amp;#10;(lower zone: injection, +Q)\&quot;]\n    Z2 --&gt; QC\n    Z3 --&gt; QC0[\&quot;Q_calculated = 0\&quot;]\n    Z4 --&gt; QCU[\&quot;Q_calculated = 0 &amp;#8722; K &amp;times; Qmax&amp;#10;(upper zone: absorption, &amp;#8722;Q)\&quot;]\n    Z5 --&gt; QCU\n\n    QC --&gt; TR{\&quot;Trigger check (slow ring, O.7.3.2):&amp;#10;|Q_calculated &amp;#8722; Q_sp| &amp;ge; &amp;#948;Q ?&amp;#10;evaluated every &amp;#916;T = 10&amp;#8211;600s, default 60s\&quot;}\n    QC0 --&gt; TR\n    QCU --&gt; TR\n    TR -- \&quot;No\&quot; --&gt; NOCH[\&quot;No update &amp;#8212; Q_sp unchanged&amp;#10;wait for next &amp;#916;T cycle\&quot;]\n    TR -- \&quot;Yes\&quot; --&gt; PUSH[\&quot;OUTPUT TO INVERTER:&amp;#10;Q_sp_new = Q_calculated&amp;#10;sent via internal network (Modbus/61850)\&quot;]\n\n    PUSH --&gt; FAST[\&quot;FAST RING CHECK (O.7.3.1):&amp;#10;inverter&#39;s actual Q at POC must settle&amp;#10;within &amp;#177;5% of Q_sp_new\&quot;]\n    FAST --&gt; SETTLE{\&quot;Settled within&amp;#10;TsQ &amp;le; 10 s ?&amp;#10;(verified per N.7.4.1 / N.6.2.3)\&quot;}\n    SETTLE -- \&quot;Yes\&quot; --&gt; DONE[\&quot;Set-point achieved &amp;#8212;&amp;#10;inverter now tracking Q_sp_new\&quot;]\n    SETTLE -- \&quot;No / anomaly\&quot; --&gt; FLAG[\&quot;Flag deviation&amp;#10;(see O.13.6 self-diagnostics)\&quot;]\n\n    DONE --&gt; NOCH\n    NOCH --&gt; TR&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="52">

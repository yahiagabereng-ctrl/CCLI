        <mxCell id="cap_no" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;fontColor=#312e81;strokeColor=#6366f1;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" value="&lt;b&gt;NO — Apply CEI 0-16 §8.8.6 capability constraints&lt;/b&gt;&lt;br&gt;Move to the nearest feasible operating point while respecting required service priority and the capability limits of the plant elements.&lt;br&gt;Example: reduce active power when necessary to satisfy a reactive-power request." vertex="1">
          <mxGeometry height="110" width="510" x="1000" y="2005" as="geometry" />
        </mxCell>
        <mxCell id="override" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;fontColor=#7c2d12;strokeColor=#f59e0b;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" value="Apply higher-level override/interlock check before actuation&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Machine-local over/under-frequency transient controls and defense-plan actions have overriding priority. CCI must not implement the frequency-transient regulation itself or counteract it.&lt;/font&gt;" vertex="1">

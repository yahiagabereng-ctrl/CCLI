          <mxGeometry height="65" width="2130" x="1030" y="115" as="geometry" />
        </mxCell>
        <mxCell id="NV9Cqq-3Jn1fBgIDUr8G-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff5ff;strokeColor=#608de2;fontColor=#163f83;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=10;arcSize=12;strokeWidth=2;" value="&lt;b&gt;[CEI] PLANT CONFIGURATION — PdC CAPABILITY&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Pimm&lt;/b&gt; = max active power injection [kW]&lt;br&gt;&lt;b&gt;Pass&lt;/b&gt; = max active power absorption [kW]&lt;br&gt;&lt;b&gt;Qcap&lt;/b&gt; = max capacitive reactive power [kvar]&lt;br&gt;&lt;b&gt;Qind&lt;/b&gt; = max inductive reactive power [kvar]&lt;br&gt;&lt;br&gt;Configured in the Operating Rule; generation/storage capability, loads excluded" vertex="1">
          <mxGeometry height="300" width="450" x="970" y="205" as="geometry" />
        </mxCell>
        <mxCell id="NV9Cqq-3Jn1fBgIDUr8G-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e4aa52;fontColor=#81500b;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=10;arcSize=12;strokeWidth=2;" value="&lt;b&gt;[CEI] MAXIMUM APPARENT POWER REFERENCE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Smax = √[ max(Pimm², Pass²) + max(Qind², Qcap²) ]&lt;/b&gt;&lt;br&gt;&lt;br&gt;Configured in the CCI from the Operating Rule.&lt;br&gt;&lt;b&gt;Smax remains the p.u. reference when available capability changes due to outage/maintenance.&lt;/b&gt;" vertex="1">
          <mxGeometry height="245" width="650" x="1530" y="232.5" as="geometry" />
        </mxCell>
        <mxCell id="NV9Cqq-3Jn1fBgIDUr8G-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8f2;strokeColor=#3fa27a;fontColor=#176044;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=10;arcSize=12;strokeWidth=2;" value="&lt;b&gt;[DERIVED] NORMALIZATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Ppu = P / Smax&lt;/b&gt;&lt;br&gt;&lt;b&gt;Qpu = Q / Smax&lt;/b&gt;&lt;br&gt;&lt;br&gt;Direct mathematical implementation of CEI requirement that Smax is the common p.u. reference" vertex="1">
          <mxGeometry height="220" width="430" x="2310" y="245" as="geometry" />
        </mxCell>
        <mxCell id="NV9Cqq-3Jn1fBgIDUr8G-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff5ff;strokeColor=#608de2;fontColor=#163f83;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=10;arcSize=12;strokeWidth=2;" value="&lt;b&gt;[SW ARCH] CONSUMERS INTERFACE&lt;/b&gt;&lt;br&gt;&lt;br&gt;O.11 priority / feasibility&lt;br&gt;Q(V), cosφ(P), fixed-setpoint modules&lt;br&gt;FastAllocator" vertex="1">
          <mxGeometry height="220" width="300" x="2840" y="245" as="geometry" />
        </mxCell>
        <mxCell id="NV9Cqq-3Jn1fBgIDUr8G-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#b4c1d0;fontColor=#526278;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;spacing=10;arcSize=12;strokeWidth=2;" value="&lt;b&gt;[SW ARCH] DynamicAvailableCapability&lt;/b&gt;&lt;br&gt;&lt;br&gt;Compute / track the currently feasible plant or section capability from element capability and availability.&lt;br&gt;&lt;br&gt;&lt;b&gt;[CEI RULE]&lt;/b&gt; update capability for outage / maintenance.&lt;br&gt;&lt;b&gt;[CEI RULE]&lt;/b&gt; do not change Smax because of these availability updates." vertex="1">
          <mxGeometry height="240" width="650" x="1530" y="590" as="geometry" />
        </mxCell>
        <mxCell id="NV9Cqq-3Jn1fBgIDUr8G-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff5ff;strokeColor=#608de2;fontColor=#163f83;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=10;arcSize=12;strokeWidth=2;" value="&lt;b&gt;[SW ARCH] ElementCapabilityStatus&lt;/b&gt;&lt;br&gt;&lt;br&gt;Per-element inverter / storage / generator:&lt;br&gt;• capability limits / curve&lt;br&gt;• online / available status&lt;br&gt;• current operating state" vertex="1">
          <mxGeometry height="210" width="360" x="1030" y="605" as="geometry" />
        </mxCell>
        <mxCell id="NV9Cqq-3Jn1fBgIDUr8G-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8f2;strokeColor=#3fa27a;fontColor=#176044;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=10;arcSize=12;strokeWidth=2;" value="&lt;b&gt;[SW ARCH] TO O.11&lt;/b&gt;&lt;br&gt;&lt;br&gt;Expose:&lt;br&gt;• configured Smax / plant references&lt;br&gt;• current feasible capability&lt;br&gt;&lt;br&gt;Used for priority + feasibility resolution" vertex="1">
          <mxGeometry height="220" width="400" x="2580" y="505" as="geometry" />
        </mxCell>
        <mxCell id="NV9Cqq-3Jn1fBgIDUr8G-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf8f2;strokeColor=#3fa27a;fontColor=#176044;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=10;arcSize=12;strokeWidth=2;" value="&lt;b&gt;[SW ARCH] TO FastAllocator&lt;/b&gt;&lt;br&gt;&lt;br&gt;Expose per-element capability / status&lt;br&gt;&lt;br&gt;Used to create feasible Pi* / Qi* commands" vertex="1">
          <mxGeometry height="240" width="400" x="2580" y="740" as="geometry" />
        </mxCell>

        <mxCell id="p6b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;fontColor=#4c1d95;strokeColor=#8b5cf6;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" value="Q = f(V)&lt;br&gt;O.9.1.3" vertex="1">

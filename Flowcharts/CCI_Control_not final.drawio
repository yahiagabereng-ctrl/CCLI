  <diagram id="cci-o11-priority-flow-v2" name="CCI O.11 Priority Flow">
    <mxGraphModel dx="4040" dy="2403" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="2500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;fontColor=#ffffff;strokeColor=#0f172a;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" value="CCI O.11 — Compatibility &amp; Priority Arbitration" vertex="1">
          <mxGeometry height="60" width="1500" x="300" y="30" as="geometry" />
        </mxCell>
        <mxCell id="sub" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;fontColor=#334155;strokeColor=#cbd5e1;fontSize=13;align=center;verticalAlign=middle;" value="This page handles activation requests, plant-function availability, O.11 compatibility, configurable priorities, P-limit arbitration and capability conflicts. Communication, measurements, regulation-curve calculations and device allocation belong on separate CCI pages." vertex="1">
          <mxGeometry height="48" width="1500" x="300" y="100" as="geometry" />
        </mxCell>
        <mxCell id="start" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;fontColor=#0f172a;strokeColor=#64748b;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" value="New regulation-function ACTIVATION request" vertex="1">
          <mxGeometry height="62" width="580" x="760" y="185" as="geometry" />
        </mxCell>
        <mxCell id="lookup" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;fontColor=#312e81;strokeColor=#6366f1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" value="Look up O.11 compatibility against the CURRENT ACTIVE function set&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;P ↔ Q compatible · Q functions mutually incompatible · P target/modulation functions mutually incompatible · P-limit functions may coexist&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="720" x="690" y="550" as="geometry" />
        </mxCell>
        <mxCell id="incompat" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff7ed;fontColor=#0f172a;strokeColor=#f59e0b;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" value="Is any currently ACTIVE function incompatible with NEW?" vertex="1">
          <mxGeometry height="130" width="460" x="820" y="705" as="geometry" />
        </mxCell>
        <mxCell id="activate_compatible" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;fontColor=#065f46;strokeColor=#10b981;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" value="NO — Activate NEW and retain all compatible active functions" vertex="1">
          <mxGeometry height="90" width="500" x="230" y="888" as="geometry" />
        </mxCell>
        <mxCell id="read_prio" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;fontColor=#0f172a;strokeColor=#64748b;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" value="Read CURRENT CONFIGURED executive-priority indices&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Do not assume the default order is permanently hard-coded&lt;/font&gt;" vertex="1">
          <mxGeometry height="88" width="430" x="835" y="890" as="geometry" />
        </mxCell>
        <mxCell id="prio" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff7ed;fontColor=#0f172a;strokeColor=#f59e0b;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" value="Is NEW priority index ≤ incompatible ACTIVE index?" vertex="1">
          <mxGeometry height="130" width="410" x="845" y="1025" as="geometry" />
        </mxCell>
        <mxCell id="replace" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;fontColor=#065f46;strokeColor=#10b981;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" value="YES — Activate NEW and simultaneously deactivate the previous incompatible function(s)" vertex="1">
          <mxGeometry height="100" width="500" x="585" y="1215" as="geometry" />
        </mxCell>
        <mxCell id="reject" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;fontColor=#991b1b;strokeColor=#ef4444;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" value="NO — Reject NEW activation request&lt;br&gt;Existing higher-priority incompatible control remains active" vertex="1">
          <mxGeometry height="100" width="500" x="1190" y="1215" as="geometry" />
        </mxCell>
        <mxCell id="reject_end" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;fontColor=#881337;strokeColor=#fb7185;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" value="REQUEST HANDLED — active control set unchanged" vertex="1">
          <mxGeometry height="68" width="410" x="1235" y="1360" as="geometry" />
        </mxCell>
        <mxCell id="active_set" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;fontColor=#065f46;strokeColor=#10b981;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" value="Accepted ACTIVE function set updated" vertex="1">
          <mxGeometry height="72" width="500" x="600" y="1370" as="geometry" />
        </mxCell>
        <mxCell id="p_arbitration" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;fontColor=#1e3a8a;strokeColor=#3b82f6;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" value="&lt;b&gt;Resolve ACTIVE-P functions&lt;/b&gt;&lt;br&gt;• At most one incompatible P target/modulation function remains active.&lt;br&gt;• Evaluate active P-limit functions O.9.2.1 / O.9.2.2 together with the P target, if any.&lt;br&gt;• The effective P requirement/ceiling is the most restrictive applicable value." vertex="1">
          <mxGeometry height="135" width="560" x="570" y="1490" as="geometry" />
        </mxCell>

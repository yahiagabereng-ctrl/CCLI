        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  layout: elk\n---\nflowchart TD\n    ORIGIN[\&quot;Command origin: Aggregator (BSP)\nvia Eth_B interface (O.13.1.3)\nfor MSD participation (O.10.3 / O.10.4)\&quot;] --&gt; OPST[\&quot;Operating status\nRange: 1=Operating / 5=Not-Operating\nDefault: 5\&quot;]\n\n    OPST --&gt; OPCHK{\&quot;Status = 1\n(Operating)?\&quot;}\n    OPCHK -- \&quot;No\&quot; --&gt; IDLE[\&quot;Function idle -\nno Q set-point applied\&quot;]\n    OPCHK -- \&quot;Yes\&quot; --&gt; ACT[\&quot;Activation command\nRange: 5=Inactive / 1=Active\nDefault: 5\&quot;]\n\n    ACT --&gt; ACHK{\&quot;Command = 1\n(Active)?\&quot;}\n    ACHK -- \&quot;No\&quot; --&gt; IDLE\n    ACHK -- \&quot;Yes\&quot; --&gt; FST[\&quot;Function status\nRange: 0=Not available / 2=Automatic(Priority)\nDefault: 2 - note: no Autonomous option,\nalways externally driven\&quot;]\n\n    FST --&gt; PRIO{\&quot;Priority check - Table 1:\nthis function = index 7 (LOWEST priority)\nany other active function wins\&quot;}\n    PRIO -- \&quot;Higher-priority function\nalready active\&quot; --&gt; BLOCK[\&quot;Not activated -\nexisting function stays in control\&quot;]\n    PRIO -- \&quot;No conflicting\nhigher-priority function\&quot; --&gt; TARGET[\&quot;Feed-in / feed-out reactive power target\nRange: 0..100% of Smax (+capacitive / -inductive)\nDefault: 0 / 0\&quot;]\n\n    TARGET --&gt; NOFORM[\&quot;Trigger equation: NONE -\ndirect target tracking, no formula\n(same as O.9.1.4)\&quot;]\n\n    NOFORM --&gt; DIST[\&quot;Distribute Q target across plant elements\n(method left to User / plant designer,\nper O.9.1.4 implementation)\&quot;]\n\n    DIST --&gt; CAP{\&quot;Can plant capability\nreach requested Q?\&quot;}\n    CAP -- \&quot;No\&quot; --&gt; CLOSEST[\&quot;Bring plant to closest\nachievable Q value\&quot;]\n    CAP -- \&quot;Yes\&quot; --&gt; PUSH[\&quot;OUTPUT TO INVERTERS:\nQ_sp_new pushed across generating units\nvia internal network (Modbus/61850)\&quot;]\n    CLOSEST --&gt; PUSH\n\n    PUSH --&gt; FAST[\&quot;Fast ring settling check (O.7.3.1):\nactual Q at POC must settle within\n+/-5% of Q_sp_new within TsQ &lt;= 10 s\&quot;]\n\n    FAST --&gt; RATE[\&quot;External Set-Point Dynamics (O.7.3.3):\nnext update accepted only if\n&gt;= 3 s since last processed set-point\n- faster updates REJECTED\&quot;]\n\n    RATE --&gt; FEEDBACK[\&quot;Q measurement fed back to Aggregator\n(instantaneous Q, per O.8.5)\&quot;]\n\n    FEEDBACK --&gt; WAIT[\&quot;Hold current Q_sp\nuntil next valid Aggregator command\n(&gt;= 3 s later) or priority override\&quot;]\n    WAIT --&gt; ACHK&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="42">

        <mxCell id="note2" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=2;fontSize=15;fontColor=#253044;spacing=10;" value="&lt;b&gt;[CEI] SCOPE&lt;/b&gt;&lt;br&gt;Autonomous limitation near 110% U&lt;sub&gt;n&lt;/sub&gt;. Independent interface/unit overvoltage protection still acts separately." vertex="1">
          <mxGeometry height="132" width="480" x="1790" y="309" as="geometry" />

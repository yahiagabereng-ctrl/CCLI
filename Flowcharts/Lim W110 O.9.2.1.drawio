  <diagram id="cci-p110-function" name="P limit near 110% Un">
    <mxGraphModel dx="3768" dy="1682" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="2130" math="0" shadow="0">
      <root>
        <mxCell id="0" />

        <mxCell id="heading" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=20;fontColor=#253044;spacing=10;" value="&lt;b&gt;O.9.2.1 | Active-power injection limit near 110% U&lt;sub&gt;n&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;Autonomous CCI function at PdC · plant-specific parameters are configurable · output is a P ceiling" vertex="1">
          <mxGeometry height="82" width="1720" x="35" y="20" as="geometry" />
        </mxCell>
        <mxCell id="user" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fontColor=#253044;spacing=10;;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" value="&lt;b&gt;USER ACTIVATION — FIXED REQUIREMENT&lt;/b&gt;&lt;br&gt;The User enables/disables this autonomous function via the User terminal, on site or remotely.&lt;br&gt;Define retained state after restart in the implementation." vertex="1">
          <mxGeometry height="128" width="435" x="35" y="148" as="geometry" />
        </mxCell>
        <mxCell id="params" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fontColor=#253044;spacing=10;;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" value="&lt;b&gt;PLANT CONFIGURATION — ENTER APPROVED VALUES&lt;/b&gt;&lt;br&gt;U&lt;sub&gt;n&lt;/sub&gt; at PdC: configurable from plant data.&lt;br&gt;P&lt;sub&gt;n&lt;/sub&gt; of each generating unit: configurable from unit data.&lt;br&gt;Overvoltage protection settings: reference for coordination." vertex="1">
          <mxGeometry height="150" width="435" x="35" y="300" as="geometry" />
        </mxCell>
        <mxCell id="meter" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fontColor=#253044;spacing=10;;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" value="&lt;b&gt;PdC MEASUREMENT CONFIGURATION&lt;/b&gt;&lt;br&gt;Voltage source and evaluated voltage quantity: configurable for the plant.&lt;br&gt;Measurement validity/freshness criteria: define for the device." vertex="1">
          <mxGeometry height="130" width="435" x="35" y="482" as="geometry" />
        </mxCell>
        <mxCell id="note1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=2;fontSize=15;fontColor=#253044;spacing=10;" value="&lt;b&gt;PARAMETER SOURCES&lt;/b&gt;&lt;br&gt;Plant design / as-built data: U&lt;sub&gt;n&lt;/sub&gt;, unit P&lt;sub&gt;n&lt;/sub&gt;, voltage meter and protection settings.&lt;br&gt;Commissioning approval: intervention rule, P(V) curve and Q(V) coordination." vertex="1">

        <UserObject label="&lt;b&gt;DSO ACTIVE-POWER MODULATION — O.9.2.3&lt;/b&gt;&lt;br&gt;Command origin: DSO via Eth_A (O.13.1.2).&lt;br&gt;Same implementation as O.10.3.1." mermaidId="n:ORIGIN" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Command origin: Aggregator (BSP)&#xa;via Eth_B interface (O.13.1.3)&#xa;for MSD participation (O.10.3.1)" id="2">

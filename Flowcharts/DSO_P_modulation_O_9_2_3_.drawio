        <UserObject label="&lt;b&gt;FUNCTION STATUS — TABLE 85&lt;/b&gt;&lt;br&gt;0 = Not available / 2 = Enabled (Priority); default: 2.&lt;br&gt;Status 0 → unavailable: no activation. Status 2 → shared priority check.&lt;br&gt;DSO channel loss → configured fallback (page 2)." mermaidId="n:FST" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Function status&#xa;Range: 0=Not available / 2=Automatic(Priority)&#xa;Default: 2 - always externally driven,&#xa;no Autonomous option" id="8">
          <mxCell parent="42" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="112" width="902" x="401.33" y="1441" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;SHARED O.11 PRIORITY CHECK&lt;/b&gt;&lt;br&gt;Default O.9.2.3 index = 3.&lt;br&gt;Check conflicts with other P setpoint modes.&lt;br&gt;New index ≤ existing index → replace conflicting mode.&lt;br&gt;Otherwise reject activation.&lt;br&gt;P ceilings remain compatible constraints." mermaidId="n:PRIO" mermaidBaseStyle="rhombus;html=1;strokeWidth=1;whiteSpace=wrap;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Priority check - Table 1:&#xa;this function = index 4&#xa;(beats index 5-7, loses to 1-3)" id="9">
          <mxCell parent="42" style="rhombus;html=1;strokeWidth=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="360" width="568" x="568.33" y="1583" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Activation refused:&lt;br&gt;existing authorised mode stays in control." mermaidId="n:BLOCK" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Not activated -&#xa;existing function stays in control" id="10">
          <mxCell parent="42" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="73" width="359" x="79" y="2040" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;SIGNED TARGET — TABLE 85&lt;/b&gt;&lt;br&gt;Magnitude s: 0…100%; reference: plant Smax. Defaults: injection 100% / absorption 0%.&lt;br&gt;&lt;b&gt;P_req = σ × (s / 100) × Smax&lt;/b&gt;; σ = +1 injection, −1 absorption." mermaidId="n:TARGET" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Feed-in / feed-out active power setpoints&#xa;Range: 0..100% of Smax (+feed-in / -feed-out)&#xa;Default: 100 / 0 (full production baseline)" id="11">
          <mxCell parent="42" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="93" width="958" x="468" y="2040" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;SETPOINT TIMING CHECK — O.7.3.3&lt;/b&gt;&lt;br&gt;First processed setpoint OR t_now − t_last ≥ 3 s?&lt;br&gt;Reject faster updates; preserve accepted target and timestamp." mermaidId="n:NOFORM" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Trigger equation: NONE -&#xa;direct target tracking, no formula" id="12">
          <mxCell parent="42" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="85" width="439" x="727.5" y="2163" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;ACCEPT TARGET / SHARED RESOLVER&lt;/b&gt;&lt;br&gt;S⁺ = P_req; t_last⁺ = t_now for processed setpoint.&lt;br&gt;P_bounded = min(S, applicable active P ceilings); no ceilings → S.&lt;br&gt;Resolve P/Q capability and allocate generation / storage subject to SoC." mermaidId="n:DIST" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Distribute P target across generating units,&#xa;and/or storage system modulation&#xa;if compatible with state of charge&#xa;(architecture left to User/plant designer)" id="13">
          <mxCell parent="42" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="112" width="1126" x="196.33" y="2358" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Can plant reach&lt;br&gt;P_bounded?" mermaidId="n:CAP" mermaidBaseStyle="rhombus;html=1;strokeWidth=1;whiteSpace=wrap;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Can plant capability&#xa;reach requested P?" id="14">
          <mxCell parent="42" style="rhombus;html=1;strokeWidth=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="246" width="297" x="518.25" y="12" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Resolve feasible P_ref&lt;br&gt;subject to capability / priorities.&lt;br&gt;Report limiting condition." mermaidId="n:CLOSEST" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Bring plant to closest&#xa;achievable P value" id="15">
          <mxCell parent="42" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="73" width="303" x="428" y="365" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;SHARED FAST RING → UNIT COMMANDS&lt;/b&gt;&lt;br&gt;Track feasible PdC target P_ref through allocated unit commands.&lt;br&gt;Respect unit capability and configured gradients (equations on page 2)." mermaidId="n:PUSH" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="OUTPUT TO GENERATING UNITS:&#xa;P_sp_new pushed across units&#xa;via internal network (Modbus/61850)" id="16">
          <mxCell parent="42" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="93" width="732" x="253" y="470" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;FAST-RING RESPONSE — O.7.3.1&lt;/b&gt;&lt;br&gt;TsP ≤ 60 s for any internal active-power setpoint change.&lt;br&gt;Use the prescribed ±5% settling band and referenced test method.&lt;br&gt;Retain requested S separately from feasible P_ref." mermaidId="n:FAST" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Fast ring settling check (O.7.3.1):&#xa;actual P at POC must settle within&#xa;+/-5% of P_sp_new within TsP&#xa;(time explicitly stated as&#xa;&#39;within the time prescribed in O.7.3.1&#39;)" id="17">
          <mxCell parent="42" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="131" width="1192" x="23" y="593" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;CONTINUOUS SHARED FEEDBACK&lt;/b&gt;&lt;br&gt;e_P[k] = P_ref[k] − P_PdC,MC200[k].&lt;br&gt;Positive error: increase net injection;&lt;br&gt;negative error: reduce net injection." mermaidId="n:RATE" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="External Set-Point Dynamics (O.7.3.3):&#xa;next update accepted only if&#xa;&gt;= 3 s since last processed set-point&#xa;- faster updates REJECTED" id="18">
          <mxCell parent="42" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="112" width="512" x="363" y="777" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Publish required PdC P and function status to DSO.&lt;br&gt;Record diagnostics / changes as required by O.14 / O.11." mermaidId="n:FEEDBACK" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="P measurement fed back to Aggregator&#xa;(instantaneous P at POC, per O.8.5)" id="19">
          <mxCell parent="42" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="73" width="553" x="342.5" y="943" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Hold accepted S between valid updates; continue regulation.&lt;br&gt;Release → inactive; priority override → shared O.11.&lt;br&gt;Channel loss → page 2; valid next update → timing check." mermaidId="n:WAIT" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Hold current P_sp until next&#xa;valid Aggregator command (&gt;=3s later)&#xa;or priority override" id="20">
          <mxCell parent="42" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="93" width="640" x="299" y="1046" as="geometry" />

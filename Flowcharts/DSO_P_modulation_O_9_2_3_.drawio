        <UserObject label="&lt;b&gt;ACTIVATION COMMAND — TABLE 85&lt;/b&gt;&lt;br&gt;−5 = Inactive / −1 = Active; default: −5.&lt;br&gt;New activation requires the DSO channel and a valid target." mermaidId="n:ACT" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Activation command&#xa;Range: -5=Inactive / -1=Active&#xa;Default: -5" id="6">
          <mxCell parent="42" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="93" width="447" x="1029.83" y="1046" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Command = −1&lt;br&gt;(Active)?" mermaidId="n:ACHK" mermaidBaseStyle="rhombus;html=1;strokeWidth=1;whiteSpace=wrap;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Command = -1&#xa;(Active)?" id="7">
          <mxCell parent="42" style="rhombus;html=1;strokeWidth=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="171" width="176" x="1136" y="1171" as="geometry" />
